(module
  ;; Filesystem boundary probe. Writes 6 response bytes: e1, e2, e3, ok, data, pad.
  ;;   e1 = path_open(3, "sandbox.txt", fd-read)      -> 0 only if the file exists in the preopen
  ;;   e2 = path_open(3, "../outside", fd-write)      -> always != 0 (escape attempt, EPERM)
  ;;   e3 = path_open(3, "/outside", CREATE+fd-write) -> always != 0 (absolute path, EPERM)
  ;;   ok = 1 iff e1 == 0; data = first byte read from sandbox.txt when ok
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
  (memory (export "memory") 1)

  (func (export "_start")
    (call $read_byte_until_lf)
    (call $probe)
    (i32.store (i32.const 4) (i32.const 2048))
    (i32.store (i32.const 8) (i32.const 6))
    (i32.const 1)
    (i32.const 4)
    (i32.const 1)
    (i32.const 12)
    (call $fd_write)
    (drop)
  )

    (func $read_byte_until_lf
    (block
      (loop
        (i32.store (i32.const 4) (i32.const 256))
        (i32.store (i32.const 8) (i32.const 1))
        (i32.const 0)
        (i32.const 4)
        (i32.const 1)
        (i32.const 12)
        (call $fd_read)
        (drop)
        (i32.load (i32.const 12))
        (i32.const 0)
        (i32.eq)
        (if (then (br 0)))
        (i32.load8_u (i32.const 256))
        (i32.const 10)
        (i32.eq)
        (if (then (br 0)))
        (br 1)
      )
    )
  )

  (func $probe
    (i32.const 3)
    (i32.const 3000)
    (i32.const 11)
    (i32.const 0)
    (i64.const 2)
    (i64.const 0)
    (i32.const 0)
    (i32.const 2054)
    (call $path_open)
    (i32.store (i32.const 2048))
    (i32.load (i32.const 2054))
    (i32.const 0)
    (i32.eq)
    (if (then
      (i32.store (i32.const 4) (i32.const 3032))
      (i32.store (i32.const 8) (i32.const 1))
      (i32.load (i32.const 2054))
      (i32.const 4)
      (i32.const 1)
      (i32.const 2049)
      (call $fd_read)
      (drop)
      (i32.load (i32.const 2049))
      (i32.const 0)
      (i32.eq)
      (if (then
        (i32.load8_u (i32.const 3032))
        (i32.store8 (i32.const 2052))
        (i32.const 1)
        (i32.store8 (i32.const 2051))
      ))
      (i32.load (i32.const 2054))
      (call $fd_close)
      (drop)
    ))
    (i32.const 3)
    (i32.const 3011)
    (i32.const 10)
    (i32.const 0)
    (i64.const 4)
    (i64.const 0)
    (i32.const 0)
    (i32.const 2056)
    (call $path_open)
    (i32.store (i32.const 2049))
    (i32.const 3)
    (i32.const 3021)
    (i32.const 8)
    (i32.const 1)
    (i64.const 4)
    (i64.const 0)
    (i32.const 0)
    (i32.const 2058)
    (call $path_open)
    (i32.store (i32.const 2050))
  )
  (data (i32.const 3000) "sandbox.txt../outside/outside")
)

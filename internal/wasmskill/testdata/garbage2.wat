(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  
  (memory (export "memory") 1)
  (func (export "_start")
    (call $read_byte_until_lf)
    (i32.store (i32.const 4) (i32.const 0))
    (i32.store (i32.const 8) (i32.const 9))
    (i32.const 1)
    (i32.const 4)
    (i32.const 1)
    (i32.const 12)
    (call $fd_write)
    (drop)
  )
  (func $read_byte_until_lf
    (block
      (loop
        (i32.store (i32.const 4) (i32.const 256))
        (i32.store (i32.const 8) (i32.const 1))
        (i32.const 0)
        (i32.const 4)
        (i32.const 1)
        (i32.const 12)
        (call $fd_read)
        (drop)
        (i32.load (i32.const 12))
        (i32.const 0)
        (i32.eq)
        (if (then (br 0)))
        (i32.load8_u (i32.const 256))
        (i32.const 10)
        (i32.eq)
        (if (then (br 0)))
        (br 1)
      )
    )
  )

  (data (i32.const 0) "not-json\n")
)

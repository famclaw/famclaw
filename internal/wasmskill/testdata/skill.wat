(module
  ;; P2 skill fixture — NDJSON/JSON-RPC 2.0 over WASI stdio.
  ;; Memory: LINE@0 (1024), lineLen@1024, idBuf@1028 (10), P@1040, nread@1063,
  ;; nwritten@1064, iovec@1068/1072, bodies @1080+, method names after.
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)

  (func $write2 (param $base i32) (param $len i32)
    (i32.store (i32.const 1068) (local.get $base))
    (i32.store (i32.const 1072) (local.get $len))
    (i32.const 1)
    (i32.const 1068)
    (i32.const 1)
    (i32.const 1064)
    (call $fd_write)
    (drop)
  )

  (func $mem_eq (param $a i32) (param $b i32) (param $n i32) (result i32)
    (local $i i32)
    (local $same i32)
    (i32.const 1)
    (local.set $same)
    (i32.const 0)
    (local.set $i)
    (block $done
      (loop $loop
        (local.get $i)
        (local.get $n)
        (i32.ge_s)
        (if (then (br $done)))
        (local.get $a)
        (local.get $i)
        (i32.add)
        (i32.load8_u)
        (local.get $b)
        (local.get $i)
        (i32.add)
        (i32.load8_u)
        (i32.ne)
        (if
          (then
            (i32.const 0)
            (local.set $same)
            (br $done)
          )
          (else (nop))
        )
        (local.get $i)
        (i32.const 1)
        (i32.add)
        (local.set $i)
        (br $loop)
      )
    )
    (local.get $same)
  )

  (func $find_sub (param $pat i32) (param $n i32) (result i32)
    (local $i i32)
    (local $found i32)
    (i32.const -1)
    (local.set $found)
    (i32.const 0)
    (local.set $i)
    (block $done
      (loop $loop
        (local.get $i)
        (i32.load (i32.const 1024))
        (local.get $n)
        (i32.sub)
        (i32.lt_s)
        (if (then (br $done)))
        (local.get $i)
        (local.get $n)
        (local.get $pat)
        (local.get $n)
        (call $mem_eq)
        (if (then
          (local.get $i)
          (local.set $found)
          (br $done)
        ))
        (local.get $i)
        (i32.const 1)
        (i32.add)
        (local.set $i)
        (br $loop)
      )
    )
    (local.get $found)
  )

  (func $extract_id (result i32)
    (local $p i32)
    (local $i i32)
    (i32.const 1081)
    (i32.const 5)
    (call $find_sub)
    (i32.const -1)
    (i32.eq)
    (if (then
      (i32.const 0)
      (return)
    ))
    (i32.const 1081)
    (i32.const 5)
    (call $find_sub)
    (i32.const 5)
    (i32.add)
    (local.set $p)
    (i32.const 0)
    (local.set $i)
    (block $done
      (loop $scan
        (local.get $i)
        (i32.load (i32.const 1024))
        (local.get $p)
        (i32.sub)
        (i32.lt_s)
        (if (result i32)
          (then
            (local.get $p)
            (local.get $i)
            (i32.add)
            (i32.load8_u)
            (i32.const 48)
            (i32.ge_u)
            (local.get $p)
            (local.get $i)
            (i32.add)
            (i32.load8_u)
            (i32.const 57)
            (i32.le_u)
            (i32.and)
          )
          (else (i32.const 0))
        )
        (if (then
          (local.get $p)
          (local.get $i)
          (i32.add)
          (i32.load8_u)
          (local.get $i)
          (i32.add (i32.const 1028))
          (i32.store8)
          (local.get $i)
          (i32.const 1)
          (i32.add)
          (local.set $i)
          (br $scan)
        ))
        (br $done)
      )
    )
    (local.get $i)
  )

  (func $write_resp (param $body i32) (param $bodylen i32) (param $idlen i32)
    (i32.const 1040)
    (i32.const 22)
    (call $write2)
    (local.get $idlen)
    (i32.const 0)
    (i32.gt_s)
    (if (then
      (i32.const 1081)
      (i32.const 5)
      (call $write2)
      (i32.const 1028)
      (local.get $idlen)
      (call $write2)
    ))
    (local.get $body)
    (local.get $bodylen)
    (call $write2)
    (i32.const 1080)
    (i32.const 1)
    (call $write2)
  )

  (func $respond
    (local $idlen i32)
    (call $extract_id)
    (local.set $idlen)
    (i32.const 1584)
    (i32.const 10)
    (call $find_sub)
    (i32.const -1)
    (i32.eq)
    (if
      (then
        (i32.const 1086)
        (i32.const 187)
        (local.get $idlen)
        (call $write_resp)
      )
      (else
        (i32.const 1594)
        (i32.const 12)
        (call $find_sub)
        (i32.const -1)
        (i32.eq)
        (if
          (then
            (i32.const 1619)
            (i32.const 11)
            (call $find_sub)
            (i32.const -1)
            (i32.eq)
            (if
              (then
                (i32.const 1273)
                (i32.const 75)
                (local.get $idlen)
                (call $write_resp)
              )
              (else
                (i32.const 1630)
                (i32.const 8)
                (call $find_sub)
                (i32.const -1)
                (i32.eq)
                (if
                  (then
                    (i32.const 1370)
                    (i32.const 92)
                    (local.get $idlen)
                    (call $write_resp)
                  )
                  (else
                    (i32.const 1638)
                    (i32.const 8)
                    (call $find_sub)
                    (i32.const -1)
                    (i32.eq)
                    (if
                      (then
                        (i32.const 1462)
                        (i32.const 122)
                        (local.get $idlen)
                        (call $write_resp)
                      )
                      (else
                        (i32.const 1370)
                        (i32.const 92)
                        (local.get $idlen)
                        (call $write_resp)
                      )
                    )
                  )
                )
              )
            )
          )
          (else
            (i32.const 1606)
            (i32.const 13)
            (call $find_sub)
            (i32.const -1)
            (i32.eq)
            (if
              (then
                (i32.const 1348)
                (i32.const 22)
                (local.get $idlen)
                (call $write_resp)
              )
              (else
                (i32.const 1370)
                (i32.const 92)
                (local.get $idlen)
                (call $write_resp)
              )
            )
          )
        )
      )
    )
  )

  (func $read_line (result i32)
    (local $n i32)
    (local $total i32)
    (i32.const 0)
    (local.set $n)
    (i32.const 0)
    (local.set $total)
    (block $out
      (loop $top
        (local.get $n)
        (i32.const 1023)
        (i32.gt_s)
        (if (then
          (i32.const 0)
          (return)
        ))
        (i32.store (i32.const 1068) (local.get $total))
        (i32.store (i32.const 1072) (i32.sub (i32.const 1024) (local.get $total)))
        (i32.const 0)
        (i32.const 1068)
        (i32.const 1)
        (i32.const 1063)
        (call $fd_read)
        (drop)
        (i32.load (i32.const 1063))
        (local.set $n)
        (local.get $n)
        (i32.const 0)
        (i32.eq)
        (if (then
          (i32.const 0)
          (return)
        ))
        (local.get $total)
        (local.get $n)
        (i32.add)
        (local.set $total)
        (i32.add (i32.const 0) (local.get $total))
        (i32.load8_u)
        (i32.const 10)
        (i32.eq)
        (if (then (br $out)))
        (br $top)
      )
    )
    (i32.store (i32.const 1024) (local.get $total))
    (i32.store8 (i32.add (i32.const 0) (local.get $total)) (i32.const 0))
    (i32.const 1)
  )

  (func (export "_start")
    (block $out
      (loop $top
        (call $read_line)
        (if (then (br $out)))
        (call $respond)
        (br $top)
      )
    )
  )

  (data (i32.const 1040) "{\"jsonrpc\":\"2.0\",\"id\":")
  (data (i32.const 1080) "\\n")
  (data (i32.const 1081) "\"id\":")
  (data (i32.const 1086) ",\"result\":{\"tools\":[{\"name\":\"record_fact\",\"description\":\"Record a fact into family memory\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}}]}}")
  (data (i32.const 1273) ",\"result\":{\"ok\":true,\"content\":{\"text\":\"Recorded.\"},\"data\":{\"fact_id\":\"1\"}}")
  (data (i32.const 1348) ",\"result\":{\"ok\":true}}")
  (data (i32.const 1370) ",\"error\":{\"code\":-32601,\"message\":\"unknown tool\",\"data\":{\"class\":\"logic\",\"retryable\":false}}")
  (data (i32.const 1462) ",\"error\":{\"code\":-32603,\"message\":\"sandbox violation: host fs access denied\",\"data\":{\"class\":\"sandbox\",\"retryable\":false}}")
  (data (i32.const 1584) "skill_init")
  (data (i32.const 1594) "skill_invoke")
  (data (i32.const 1606) "skill_cleanup")
  (data (i32.const 1619) "record_fact")
  (data (i32.const 1630) "bad_tool")
  (data (i32.const 1638) "sandboxy")
)
